<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wingo Number Prediction</title>
    <style>
        /* Base Styling */
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: #fff;
        }

        /* Prediction Card */
        .wingo-card {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            width: 300px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            animation: fadeIn 1s ease-in-out;
        }

        /* Header */
        .wingo-header {
            margin-bottom: 20px;
            font-size: 1.5rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Predicted Number */
        .wingo-number {
            font-size: 5rem;
            font-weight: bold;
            margin: 20px 0;
            color: #ffeb3b;
            text-shadow: 0 0 10px rgba(255, 235, 59, 0.7);
            animation: pulse 2s infinite;
        }

        /* Input Details */
        .wingo-input {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 20px;
            word-break: break-all;
        }

        /* Footer */
        .wingo-footer {
            font-size: 0.8rem;
            opacity: 0.6;
            margin-top: 20px;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="wingo-card">
        <div class="wingo-header">Wingo Prediction</div>
        <div class="wingo-input">Input: 202502121000101456</div>
        <div class="wingo-number">28</div>
        <div class="wingo-footer">1-minute period | Generated: Today</div>
    </div>
</body>
</html>
